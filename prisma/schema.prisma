generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id         Int       @id @default(autoincrement())
  externalId String?   @unique // ID групи в 1С
  slug       String    @unique
  name       String
  sortOrder  Int       @default(0)
  products   Product[]
}

model Brand {
  id         Int       @id @default(autoincrement())
  externalId String?   @unique
  slug       String    @unique
  name       String
  country    String?
  products   Product[]
}

model Product {
  id          Int                @id @default(autoincrement())
  externalId  String             @unique // унікальний ID товару в 1С — ключ для імпорту
  sku         String? // артикул
  slug        String             @unique
  name        String
  description String?
  netWeight   String? // "280 г", "1 кг"
  unitsPerBox Int?
  unit        String             @default("шт.")
  inStock     Boolean            @default(true)
  stockQty    Int?
  isActive    Boolean            @default(true)
  isPopular   Boolean            @default(false)
  sortOrder   Int                @default(0)
  categoryId  Int?
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId     Int?
  brand       Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  attributes  ProductAttribute[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isPopular])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductAttribute {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String
  sortOrder Int     @default(0)

  @@index([productId])
}

enum ImportStatus {
  RUNNING
  SUCCESS
  FAILED
}

model ImportRun {
  id          Int          @id @default(autoincrement())
  status      ImportStatus @default(RUNNING)
  source      String // шлях до файлу або назва джерела
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  total       Int          @default(0)
  created     Int          @default(0)
  updated     Int          @default(0)
  deactivated Int          @default(0)
  errorCount  Int          @default(0)
  errors      Json? // [{ item, message }]
  message     String?

  @@index([startedAt])
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
}

model PriceRequest {
  id          Int           @id @default(autoincrement())
  status      RequestStatus @default(NEW)
  company     String
  contactName String
  phone       String
  email       String?
  comment     String?
  items       Json // [{ productId, externalId, name, quantity }]
  createdAt   DateTime      @default(now())
}
