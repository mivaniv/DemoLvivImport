# PostgreSQL (docker compose up -d запускає базу на порту 5433)
DATABASE_URL="postgresql://lvivimport:lvivimport@localhost:5433/lvivimport?schema=public"

# Адреса сайту — для посилань у листах (скидання пароля, замовлення)
SITE_URL="http://localhost:3000"

# B2B-функції (ціни, вхід клієнтів, реєстрація, кошик, замовлення, прайс).
# Порожньо — каталог без цін і входу (адміністратор заходить через /account/login).
# "1" — увімкнути, коли налаштовано пошту й ціни з 1С. Після зміни — перезапуск/перезбірка.
NEXT_PUBLIC_B2B_ENABLED=""

# Пошта: SMTP_URL, напр. smtps://user:pass@smtp.example.com:465 — без нього листи пишуться в storage/mail
SMTP_URL=""
MAIL_FROM="Львівімпорт <info@lvivimport.com>"
# Куди надходять заявки, замовлення, звернення
MANAGER_EMAIL="info@lvivimport.com"

# Ціни з CommerceML: Ид або назва типу ціни (порожньо — перший тип у пропозиції)
IMPORT_PRICE_TYPE=""

# Куди імпортер копіює фото товарів; сайт віддає їх за адресою /media/...
MEDIA_DIR="./storage/media"

# Вивантаження з 1С (YML або CommerceML) для щоденного імпорту: npm run import:daily
IMPORT_SOURCE_URL=""
# Якщо посилання захищене логіном (HTTP Basic)
IMPORT_SOURCE_USER=""
IMPORT_SOURCE_PASSWORD=""
# Прибирання не виконується, якщо приховало б більшу частку активних товарів (0.3 = 30%)
IMPORT_CLEANUP_MAX_RATIO="0.3"
