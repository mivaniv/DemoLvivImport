# Ззовні доступні лише обробник форм і переадресації старих адрес (legacy.php, сюди веде .htaccess сайту).
# config.php (адреса для листів), update-catalog.php (запускає лише крон), legacy-urls.json, позначки legacy/
# і тека data/ (журнали, копії вивантаження) закриті.
<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "^(form|legacy)\.php$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^(form|legacy)\.php$">
    Allow from all
  </FilesMatch>
</IfModule>
