# Ззовні доступний лише обробник форм. config.php (адреса для листів, посилання на вивантаження),
# update-catalog.php (запускає лише крон) і тека data/ (журнали, копії вивантаження) закриті.
<IfModule mod_authz_core.c>
  Require all denied
  <Files "form.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "form.php">
    Allow from all
  </Files>
</IfModule>
